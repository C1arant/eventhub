# Copy to .env and edit. Never commit .env.

# Public URL you will use (documentation only; the app derives its origin from request headers).
PUBLIC_URL=https://events.example.com

TZ=Europe/London

# Real client IP header, so login rate-limiting is per-visitor instead of per-tunnel.
#   Cloudflare Tunnel:  ADDRESS_HEADER=cf-connecting-ip
#   Tailscale Funnel:   ADDRESS_HEADER=x-forwarded-for  (with XFF_DEPTH=1)
# Leave both blank for local-only use (the socket address is used).
ADDRESS_HEADER=
XFF_DEPTH=1

# Cloudflare Tunnel (profile "cloudflare")
TUNNEL_TOKEN=

# Tailscale Funnel (profile "tailscale")
TS_AUTHKEY=
TS_HOSTNAME=eventhub
